{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", ".firebaserc", "firestore.rules", "storage.rules", "firestore.indexes.json",
      "**/.*", "**/node_modules/**", "functions/**", "private/**", "server.js", "server.log",
      "README.md", "*.csv", "seed-firestore.js"
    ],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "us-central1" } }
    ],
    "headers": [
      { "source": "**/*.@(html|js|css|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "images/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  },
  "functions": { "source": "functions", "runtime": "nodejs22" },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" }
}
