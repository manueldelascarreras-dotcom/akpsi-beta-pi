rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos and video shown on the site. Uploads go through the CMS API only.
    match /public/{path=**} {
      allow read: if true;
      allow write: if false;
    }
    // Applicant resumes and headshots: server-only.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
